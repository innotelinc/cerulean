# ─── Cerulean portal ───────────────────────────────────────────────────────────
# Port the portal (API + dashboard) listens on
CERULEAN_PORT=3000
# Password for the portal's admin login (required — bootstrap fallback)
CERULEAN_ADMIN_PASSWORD=change-me
# Token expiry for portal logins, in hours
CERULEAN_TOKEN_TTL_HOURS=12
# 0 disables the admin-password login entirely (Authentik-only sign-in).
# The password is still required in .env because the server refuses to start
# without it — keep it, even when AUTH_LOCAL_ENABLED=0.
AUTH_LOCAL_ENABLED=1

# ─── Authentik (SSO / user management) ─────────────────────────────────────────
# OIDC issuer of your Authentik instance, e.g. http://auth.cerulean.innotel.us
# or http://<host>:9000 while the stack is being set up. When set, the login
# page offers "Sign in with Authentik". The stack includes Authentik itself
# (docker compose --profile authentik up -d); ./scripts/authentik-setup.py
# provisions the OIDC provider + application automatically.
AUTHENTIK_ISSUER_URL=
AUTHENTIK_CLIENT_ID=cerulean
AUTHENTIK_CLIENT_SECRET=
# Callback URL registered with Authentik — must match exactly
AUTHENTIK_REDIRECT_URI=http://cerulean.innotel.us/api/auth/oidc/callback
# Optional: admin credentials for ./scripts/authentik-setup.py (it logs in to
# create/update the OIDC provider). Bootstrap password for the very first run:
AUTHENTIK_ADMIN_USER=akadmin
AUTHENTIK_ADMIN_PASSWORD=
AUTHENTIK_BOOTSTRAP_PASSWORD=
# Compose-only (--profile authentik):
AUTHENTIK_SECRET_KEY=
AUTHENTIK_POSTGRESQL_PASSWORD=

# ─── Secret vault (HashiCorp Vault) ────────────────────────────────────────────
# When set, private keys + ACME account keys are mirrored into Vault (KV v2)
# and .env values may reference vault://<path>#<key> instead of plaintext.
# The compose stack ships a dev-mode Vault (docker compose --profile vault up -d).
VAULT_ADDR=
VAULT_TOKEN=
VAULT_PREFIX=cerulean

# ─── Certificate discovery ─────────────────────────────────────────────────────
# Extra directories scanned for PEM certificates (in addition to nginx proxy
# manager), comma-separated. e.g. /etc/ssl/certs,/opt/certs
CERT_DISCOVERY_DIRS=

# ─── DNS health auditing ───────────────────────────────────────────────────────
# Public resolvers used to check propagation consistency. 0 disables audits.
DNS_AUDIT_ENABLED=1
DNS_AUDIT_RESOLVERS=8.8.8.8,1.1.1.1,9.9.9.9

# ─── Let's Encrypt / ACME ──────────────────────────────────────────────────────
# Use the staging directory while testing to avoid rate limits:
#   https://acme-staging-v02.api.letsencrypt.org/directory
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# Contact email for Let's Encrypt account + expiry notices
ACME_EMAIL=admin@innotel.us



# ─── BIND server (SSH + nsupdate/TSIG) ─────────────────────────────────────────
# BIND_MODE=remote (default) points at an existing BIND server via BIND_SSH_*.
# BIND_MODE=local runs the bundled BIND + sshd container from this stack
# (docker compose --profile bind up -d): cerulean reaches it at the compose
# service name "cerulean-bind" (BIND_SSH_HOST stays overridable). The
# container generates its TSIG key + root password on first start (see
# `docker logs cerulean-bind`) — copy them into BIND_TSIG_SECRET /
# BIND_SSH_PASSWORD here.
BIND_MODE=remote
BIND_SSH_HOST=192.168.1.80
BIND_SSH_PORT=22
BIND_SSH_USER=root
# Prefer key auth: BIND_SSH_KEY_PATH. Password is only used when no key is set.
BIND_SSH_KEY_PATH=
BIND_SSH_PASSWORD=
# TSIG key used to sign dynamic updates. ./scripts/setup-bind.sh generates and
# installs it automatically. Must match named.conf exactly.
BIND_TSIG_NAME=cerulean
BIND_TSIG_SECRET=
# Zones Cerulean manages (comma-separated). Defaults to CERULEAN_ZONE.
BIND_ZONES=innotel.us
# Primary zone managed by this portal (innotel.us)
CERULEAN_ZONE=innotel.us
# Seconds to wait after an nsupdate before Let's Encrypt verifies
PROPAGATION_BUFFER_SECONDS=10

# ─── nginx proxy manager ───────────────────────────────────────────────────────
# NPM_MODE=remote (default) drives an existing external NPM server. This is the
# required mode when BIND_MODE=remote.
# NPM_MODE=local is allowed only with BIND_MODE=local and enables the complete
# NPM Edge component from ../npm: NPM + MariaDB + backup-ui. Start it with the
# npm profile; Cerulean uses the compose service name internally.
NPM_MODE=remote
NPM_API_URL=http://192.168.1.71:81
# In local mode, use the bundled service unless explicitly overridden.
# NPM_INTERNAL_API_URL is the address the Cerulean container uses; leave blank
# for http://cerulean-npm:81 in local mode. In remote mode it can override
# NPM_API_URL for container-network routing.
NPM_INTERNAL_API_URL=
# In local mode, host-side provisioning uses localhost:NPM_ADMIN_PORT. Set
# NPM_LOCAL_API_URL only when the local stack's admin API is reached elsewhere.
NPM_LOCAL_API_URL=
# NPM_ADMIN_PORT is the bundled NPM admin port in local mode.
NPM_ADMIN_PORT=81
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_BACKUP_UI_PORT=82
NPM_DB_MYSQL_PASSWORD=
NPM_DB_ROOT_PASSWORD=
NPM_BACKUP_UI_USER=
NPM_BACKUP_UI_PASSWORD=
NPM_CRON_SCHEDULE=0 2 * * *
NPM_BACKUP_RETENTION=7
NPM_EMAIL=admin@innotel.us
NPM_PASSWORD=change-me
# Optional: local BIND SSH hostname override. Defaults to cerulean-bind.
BIND_LOCAL_SSH_HOST=
# Optional: address the portal container uses for NPM. Defaults to the
# bundled service in local mode, or NPM_API_URL in remote mode.
# Upstream IP that NPM proxy hosts forward to (the portal host's LAN IP — must
# be reachable from the NPM host). Leave blank to auto-detect the setup host's
# LAN IP. Used by ./scripts/npm-proxy-hosts.py.
NPM_FORWARD_HOST=
# LAN IP of the nginx proxy manager host itself. When set (together with
# BIND_SSH_* + BIND_TSIG_SECRET), ./scripts/npm-proxy-hosts.py also creates an
# A record for every subdomain pointing at NPM, so app./api./auth./dns./certs./
# admin.<base> actually resolve.
NPM_HOST_IP=
# Base domain the provisioned proxy hosts live under; each service gets its own
# subdomain (e.g. cerulean.<base>). Defaults to CERULEAN_ZONE.
NPM_BASE_DOMAIN=
# 1 = let NPM request its own Let's Encrypt certificates for each proxy host
# (HTTP-01 — requires ports 80/443 to reach NPM). Leave 0 to create hosts
# without SSL and attach a Cerulean-issued certificate from the portal.
NPM_PROXY_SSL=0
# 1 (default) = after issuance/renewal, a wildcard certificate (e.g.
# *.innotel.us) is also attached to every matching subdomain proxy host (e.g.
# cerulean.innotel.us) — unless the host already has its own certificate.
# 0 = only attach certificates that match a proxy host domain exactly.
NPM_WILDCARD_ATTACH=1

# ─── Internal PKI (TLS client certificates for devices) ───────────────────────
# Cerulean runs a private root CA and issues per-device TLS client
# certificates from it (ECDSA P-256, clientAuth EKU) — the trust anchor for
# mTLS at the reverse proxy and MDM enrollment. The CA is created lazily on
# first issuance (or via POST /api/pki/init); its private key lives in the
# portal database and mirrors to the vault when VAULT_* is configured.
# Subject CN of the generated root CA (safe to change only before first init)
CA_COMMON_NAME=Cerulean Root CA
# Root CA validity, in days
CA_VALIDITY_DAYS=3650
# Default validity of issued client certificates, in days (~27 months)
PKI_CERT_VALIDITY_DAYS=825
# SCEP endpoint that managed devices use to obtain their client certificate.
# It is embedded in the Apple enrollment profile (.mobileconfig) you download
# under PKI & Devices → Enroll devices through MDM. Point it at the SCEP
# server your fleet signs with (see docs/device-enrollment.md).
PKI_SCEP_URL=
# CA name advertised to enrolling devices + optional shared SCEP challenge
PKI_SCEP_CA_NAME=cerulean
PKI_SCEP_CHALLENGE=

# ─── Multi-tenancy (organizations) ──────────────────────────────────────────
# Authentik group whose members get platform-admin powers (manage tenants,
# see everything). Local admin sessions are always platform admins. Regular
# members belong to a tenant when an Authentik group matches the tenant slug.
TENANT_PLATFORM_GROUP=cerulean-platform
# Authentik admin credentials for tenant administration (listing the members
# of a tenant = the users of its Authentik group). Same values the setup
# scripts use. Optional: without them the Tenants page shows guidance but no
# member list.
AUTHENTIK_API_URL=
AUTHENTIK_ADMIN_USER=akadmin
AUTHENTIK_ADMIN_PASSWORD=

# ─── Infisical (SecretOps) ─────────────────────────────────────────
# Innotel Platform Stack: secrets live in Infisical; .env is derived from it.
# Generate the keys with:
#   openssl rand -base64 32   # INFISICAL_ENCRYPTION_KEY
#   openssl rand -hex 16      # INFISICAL_AUTH_SECRET
#   openssl rand -hex 16      # INFISICAL_DB_PASSWORD
# Then: docker compose -f docker-compose.yml -f compose.infisical.yml \
#         --profile infisical up -d
#       bash scripts/infisical-setup.sh
INFISICAL_PORT=8383
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_DB_PASSWORD=
INFISICAL_ADMIN_EMAIL=
INFISICAL_ADMIN_PASSWORD=
INFISICAL_ORG=Innotel
# Written by scripts/infisical-setup.py after provisioning:
INFISICAL_WORKSPACE_ID=
INFISICAL_ENVIRONMENT=prod
INFISICAL_TOKEN=
