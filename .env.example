[TEMPLATE]
# ─── Cerulean portal ───────────────────────────────────────────────────────────
CERULEAN_PORT=3000
CERULEAN_ADMIN_PASSWORD=change-me
CERULEAN_TOKEN_TTL_HOURS=12
AUTH_LOCAL_ENABLED=1

# ─── Server identity — plug-anywhere master orchestrator ─────────────────────
# Every installation gets a stable <serverId>. It owns:
#   apex:     <serverId>.lab.innotel.us
#   wildcard: *.<serverId>.lab.innotel.us  (90-day, PKI offline → ACME when online)
# If CERULEAN_SERVER_ID is empty, Cerulean auto-generates one (stable after first DB write).
# Set it explicitly for reproducible / pre-registered hosts.
CERULEAN_SERVER_ID=
# Base lab suffix (default lab.innotel.us). Change if you self-host the lab domain.
CERULEAN_LAB_DOMAIN=lab.innotel.us
# Optional central registration — legacy flat POST. Prefer CRS below.
# (still honored; CRS also reads these as fallback for SERVER_REGISTER_*)
SERVER_REGISTER_URL=
SERVER_REGISTER_TOKEN=
# 90-day wildcard is dual-issued: PKI immediately (offline), then upgraded to ACME via Technitium when online.
SERVER_WILDCARD_VALIDITY_DAYS=90
SERVER_AUTO_WILDCARD=1

# ─── Central Registration Server (CRS) — master / slave to lab.innotel.us ───
# Home address is lab.innotel.us. Every Cerulean can be master, slave, or auto.
#  auto   (default): try to be a slave to CRS_MASTER_URL (=CRS_HOME_URL= lab.innotel.us).
#          If the master is unreachable (offline/air-gapped), become an isolated master
#          that still acts as a slave logically and will re-sync the moment online.
#  master: hold the authoritative registry and assign serverIds. REQUIRES CRS_DOMAIN.
#  slave:  register to CRS_MASTER_URL when online, hold a replica of every serverId.
# Air-gapped installs need no change: auto → isolated-master, no internet required.
# Masters still register as slaves to home (lab.innotel.us) best-effort when online.
CRS_ROLE=auto
# Authority domain for a master — e.g. lab.innotel.us. REQUIRED when CRS_ROLE=master.
CRS_DOMAIN=
# Home replica — defaults to https://lab.innotel.us. All nodes act as slave to home when online.
CRS_HOME_URL=https://lab.innotel.us
# Which master this slave registers to (defaults to CRS_HOME_URL). Point tenants at your regional master.
CRS_MASTER_URL=
# Shared secret for CRS register/registry (Bearer). Also accepts service API keys with crs:* scope.
CRS_TOKEN=
CRS_TIMEOUT_MS=10000
# Force air-gapped posture (never try to reach home). Usually unnecessary — auto handles it.
CRS_AIR_GAPPED=0

# ─── Cross-stack service API ─────────────────────────────────────────────────
# Other stacks (and CRS slaves) can talk to Cerulean with a service key:
#   Authorization: Bearer ceru_<prefix>_<secret>
# Create keys as platform admin: POST /api/service/keys { name, scopes, tenantId }
# Scopes: "*" or prefix-scoped like "dns:*", "certs:write", "crs:register", "dhcp:read".
# CRS register/registry also accept CRS_TOKEN as a lightweight shared secret.
# Service bridge mirrors /domains, /certificates, /dns/records, DHCP, blocking, PKI.
# See docs at GET /api/service/status and /api/crs/status.

# ─── Master orchestrator posture ─────────────────────────────────────────────
# Cerulean is self-sufficient: when running it can be the LAN's DHCP, DNS, certs & ad-blocking.
ORCHESTRATOR_ENABLED=1
ORCHESTRATOR_DHCP_ENABLED=1
ORCHESTRATOR_BLOCKING_ENABLED=1

# ─── Technitium DNS Server (authoritative + recursive) ───────────────────────
# DNS-01 challenges are written via Technitium HTTP API (/api/zones/records/*) — no SSH/nsupdate.
#   • Local bundled: docker compose --profile technitium up -d  (http://cerulean-technitium:5380)
#   • Remote: point TECHNITIUM_URL at your Technitium, set TOKEN or USER/PASSWORD.
TECHNITIUM_URL=http://cerulean-technitium:5380
# Long-lived API token (Technitium → Settings → API Tokens → Create). Preferred over password.
TECHNITIUM_TOKEN=
TECHNITIUM_USER=admin
TECHNITIUM_PASSWORD=
TECHNITIUM_TIMEOUT_MS=15000
# Primary zone (defaults to <serverId>.lab.innotel.us when empty). Also used to derive fallback zone.
CERULEAN_ZONE=
# Seconds to wait after publishing a TXT before Let's Encrypt verifies
PROPAGATION_BUFFER_SECONDS=10
# ── Bundled Technitium container (only when using --profile technitium) ──────
# Runs with network_mode: host — binds :53 (DNS), :67 (DHCP) and :5380 (console)
# directly on the host. scripts/setup.sh automatically disables systemd-resolved's
# stub listener so :53 is free; set CERULEAN_KEEP_RESOLVED=1 to opt out.
TECHNITIUM_ADMIN_PASSWORD=
TECHNITIUM_DOMAIN=
# With host networking these ports are the host ports Technitium binds (documentation
# only — docker port mappings are not used):
TECHNITIUM_DNS_UDP_PORT=53
TECHNITIUM_DNS_TCP_PORT=53
TECHNITIUM_WEB_PORT=5380
TECHNITIUM_DHCP_PORT=67
# Set CERULEAN_KEEP_RESOLVED=1 to leave systemd-resolved alone (remote-only DNS).
CERULEAN_KEEP_RESOLVED=0
DNS_SERVER_PREFER_IPV6=false
DNS_SERVER_RECURSION=AllowOnlyForPrivateNetworks
DNS_SERVER_ENABLE_BLOCKING=true
DNS_SERVER_BLOCK_LIST_URLS=
DNS_SERVER_FORWARDERS=1.1.1.1,8.8.8.8
DNS_SERVER_FORWARDER_PROTOCOL=Udp

# ─── Authentik (SSO / user management) ─────────────────────────────────────────
AUTHENTIK_ISSUER_URL=
AUTHENTIK_CLIENT_ID=cerulean
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://cerulean.innotel.us/api/auth/oidc/callback
AUTHENTIK_ADMIN_USER=akadmin
AUTHENTIK_ADMIN_PASSWORD=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_POSTGRESQL_PASSWORD=

# ─── Secret vault (HashiCorp Vault — the stack's secret store) ───────────────
VAULT_ADDR=
VAULT_TOKEN=
VAULT_PREFIX=cerulean

# ─── Certificate discovery ─────────────────────────────────────────────────────
CERT_DISCOVERY_DIRS=

# ─── DNS health auditing ───────────────────────────────────────────────────────
DNS_AUDIT_ENABLED=1
DNS_AUDIT_RESOLVERS=8.8.8.8,1.1.1.1,9.9.9.9

# ─── Let's Encrypt / ACME ──────────────────────────────────────────────────────
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
ACME_EMAIL=admin@innotel.us

# ─── nginx proxy manager ───────────────────────────────────────────────────────
NPM_MODE=remote
NPM_API_URL=http://192.168.1.71:81
NPM_INTERNAL_API_URL=
NPM_LOCAL_API_URL=
NPM_ADMIN_PORT=81
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_BACKUP_UI_PORT=82
NPM_DB_MYSQL_PASSWORD=
NPM_DB_ROOT_PASSWORD=
NPM_BACKUP_UI_USER=
NPM_BACKUP_UI_PASSWORD=
NPM_CRON_SCHEDULE=0 2 * * *
NPM_BACKUP_RETENTION=7
NPM_EMAIL=admin@innotel.us
NPM_PASSWORD=change-me
NPM_FORWARD_HOST=
NPM_HOST_IP=
NPM_BASE_DOMAIN=
NPM_PROXY_SSL=0
NPM_WILDCARD_ATTACH=1

# ─── Internal PKI (TLS client certificates for devices) ───────────────────────
CA_COMMON_NAME=Cerulean Root CA
CA_VALIDITY_DAYS=3650
PKI_CERT_VALIDITY_DAYS=825
PKI_SCEP_URL=
PKI_SCEP_CA_NAME=cerulean
PKI_SCEP_CHALLENGE=

# ─── Multi-tenancy (organizations) ──────────────────────────────────────────
TENANT_PLATFORM_GROUP=cerulean-platform
AUTHENTIK_API_URL=
AUTHENTIK_ADMIN_USER=akadmin
AUTHENTIK_ADMIN_PASSWORD=


# ─── Zeus PBX (now SSO via this repo's Authentik) ─────────────────────────
# Source was a 'standalone authentik' env on zeus-pbx-platform; moved to
# this repo's bundled Authentik (ghcr.io/goauthentik). Provider 23/client zeus.
ZEUS_AUTHENTIK_ISSUER=https://auth.zeus.innotel.us/application/o/zeus
ZEUS_AUTHENTIK_CLIENT_ID=zeus
ZEUS_AUTHENTIK_PROVIDER_ID=23
