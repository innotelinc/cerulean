# ─── Cerulean portal ───────────────────────────────────────────────────────────
# Port the portal (API + dashboard) listens on
CERULEAN_PORT=3000
# Password for the portal's admin login (required)
CERULEAN_ADMIN_PASSWORD=change-me
# Token expiry for portal logins, in hours
CERULEAN_TOKEN_TTL_HOURS=12

# ─── Let's Encrypt / ACME ──────────────────────────────────────────────────────
# Use the staging directory while testing to avoid rate limits:
#   https://acme-staging-v02.api.letsencrypt.org/directory
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# Contact email for Let's Encrypt account + expiry notices
ACME_EMAIL=admin@innotel.us

# ─── DNS-01 strategy ───────────────────────────────────────────────────────────
# Which challenge strategy to use: 'bind' (default — nsupdate TXT records
# straight into your authoritative BIND server) or 'acmedns' (delegated
# challenges via the acme-dns server in the 'acmedns' compose profile).
CERULEAN_STRATEGY=bind

# ─── BIND server (SSH + nsupdate/TSIG) ─────────────────────────────────────────
BIND_SSH_HOST=192.168.1.80
BIND_SSH_PORT=22
BIND_SSH_USER=root
# Prefer key auth: BIND_SSH_KEY_PATH. Password is only used when no key is set.
BIND_SSH_KEY_PATH=
BIND_SSH_PASSWORD=
# TSIG key used to sign dynamic updates. ./scripts/setup-bind.sh generates and
# installs it automatically. Must match named.conf exactly.
BIND_TSIG_NAME=cerulean
BIND_TSIG_SECRET=
# Zones Cerulean manages (comma-separated). Defaults to CERULEAN_ZONE.
BIND_ZONES=innotel.us
# Primary zone managed by this portal (innotel.us)
CERULEAN_ZONE=innotel.us
# Seconds to wait after an nsupdate before Let's Encrypt verifies
PROPAGATION_BUFFER_SECONDS=10

# ─── acme-dns (optional — only for the 'acmedns' strategy) ─────────────────────
# API base URL of the acme-dns server (from the portal container: http://acme-dns:4443)
ACMEDNS_API_URL=http://acme-dns:4443
# Public IP of the host running acme-dns on port 53 (needed for the delegation
# records it serves). Leave blank if you use the 'bind' strategy.
ACMEDNS_PUBLIC_IP=
# Domain the acme-dns server is authoritative for, e.g. auth.innotel.us
ACMEDNS_DOMAIN=auth.innotel.us
# Optional: restrict acme-dns /update calls to the portal's egress IP (CIDR list)
ACMEDNS_ALLOW_FROM=

# ─── nginx proxy manager ───────────────────────────────────────────────────────
NPM_API_URL=http://192.168.1.71:81
NPM_EMAIL=admin@innotel.us
NPM_PASSWORD=change-me
