# ─── Cerulean portal ───────────────────────────────────────────────────────────
CERULEAN_PORT=3000
CERULEAN_TOKEN_TTL_HOURS=12

# ─── Sign-in posture ──────────────────────────────────────────────────────────
# Identity is Authentik, so the admin-password path is OFF by default: the
# portal offers "Sign in with Authentik" only, and POST /api/auth/login answers
# 403 so a session cannot be minted locally even if the form is reached
# directly (see server/src/config.ts + routes.ts).
#
# BREAKGLASS_LOGIN=1 re-enables the local password path for recovery when
# Authentik is unreachable. Set it, sign in, fix Authentik, then unset it and
# restart. AUTH_LOCAL_ENABLED is the legacy name for the same switch and is
# still honoured when BREAKGLASS_LOGIN is absent — leave both unset normally.
BREAKGLASS_LOGIN=
AUTH_LOCAL_ENABLED=

# Used only while the local path is enabled.
CERULEAN_ADMIN_PASSWORD=change-me

# ─── Server identity — plug-anywhere master orchestrator ─────────────────────
# Every installation gets a stable <serverId>. It owns:
#   apex:     <serverId>.lab.innotel.us
#   wildcard: *.<serverId>.lab.innotel.us  (90-day, PKI offline → ACME when online)
# If CERULEAN_SERVER_ID is empty, Cerulean auto-generates one (stable after first DB write).
# Set it explicitly for reproducible / pre-registered hosts.
CERULEAN_SERVER_ID=
# Base lab suffix (default lab.innotel.us). Change if you self-host the lab domain.
CERULEAN_LAB_DOMAIN=lab.innotel.us
# Optional central registration — legacy flat POST. Prefer CRS below.
# (still honored; CRS also reads these as fallback for SERVER_REGISTER_*)
SERVER_REGISTER_URL=
SERVER_REGISTER_TOKEN=
# 90-day wildcard is dual-issued: PKI immediately (offline), then upgraded to ACME via Technitium when online.
SERVER_WILDCARD_VALIDITY_DAYS=90
SERVER_AUTO_WILDCARD=1

# ─── Central Registration Server (CRS) — master / slave to lab.innotel.us ───
# Home address is lab.innotel.us. Every Cerulean can be master, slave, or auto.
#  auto   (default): try to be a slave to CRS_MASTER_URL (=CRS_HOME_URL= lab.innotel.us).
#          If the master is unreachable (offline/air-gapped), become an isolated master
#          that still acts as a slave logically and will re-sync the moment online.
#  master: hold the authoritative registry and assign serverIds. REQUIRES CRS_DOMAIN.
#  slave:  register to CRS_MASTER_URL when online, hold a replica of every serverId.
# Air-gapped installs need no change: auto → isolated-master, no internet required.
# Masters still register as slaves to home (lab.innotel.us) best-effort when online.
CRS_ROLE=auto
# Authority domain for a master — e.g. lab.innotel.us. REQUIRED when CRS_ROLE=master.
CRS_DOMAIN=
# Home replica — defaults to https://lab.innotel.us. All nodes act as slave to home when online.
CRS_HOME_URL=https://lab.innotel.us
# Which master this slave registers to (defaults to CRS_HOME_URL). Point tenants at your regional master.
CRS_MASTER_URL=
# Shared secret for CRS register/registry (Bearer). Also accepts service API keys with crs:* scope.
CRS_TOKEN=
CRS_TIMEOUT_MS=10000
# Force air-gapped posture (never try to reach home). Usually unnecessary — auto handles it.
CRS_AIR_GAPPED=0

# ─── Cross-stack service API ─────────────────────────────────────────────────
# Other stacks (and CRS slaves) can talk to Cerulean with a service key:
#   Authorization: Bearer ceru_<prefix>_<secret>
# Create keys as platform admin: POST /api/service/keys { name, scopes, tenantId }
# Scopes: "*" or prefix-scoped like "dns:*", "certs:write", "crs:register", "dhcp:read".
# CRS register/registry also accept CRS_TOKEN as a lightweight shared secret.
# Service bridge mirrors /domains, /certificates, /dns/records, DHCP, blocking, PKI.
# See docs at GET /api/service/status and /api/crs/status.

# ─── Master orchestrator posture ─────────────────────────────────────────────
# Cerulean is self-sufficient: when running it can be the LAN's DHCP, DNS, certs & ad-blocking.
ORCHESTRATOR_ENABLED=1
ORCHESTRATOR_DHCP_ENABLED=1
ORCHESTRATOR_BLOCKING_ENABLED=1

# ─── Technitium DNS Server (authoritative + recursive) ───────────────────────
# DNS-01 challenges are written via Technitium HTTP API (/api/zones/records/*) — no SSH/nsupdate.
#   • Local bundled: docker compose --profile technitium up -d  (http://cerulean-technitium:5380)
#   • Remote: point TECHNITIUM_URL at your Technitium, set TOKEN or USER/PASSWORD.
# Loopback + docker0 only: the console is the DNS/DHCP admin plane, so it must
# not answer on the LAN. Containers dial this via http://172.17.0.1:5380 and the
# public door is dns.<domain> through its oauth2-proxy gateway.
TECHNITIUM_WEB_SERVICE_LOCAL_ADDRESSES=127.0.0.1,172.17.0.1
TECHNITIUM_URL=http://cerulean-technitium:5380
# Long-lived API token (Technitium → Settings → API Tokens → Create). Preferred over password.
TECHNITIUM_TOKEN=
TECHNITIUM_USER=admin
TECHNITIUM_PASSWORD=
TECHNITIUM_TIMEOUT_MS=15000
# ── The console's own sign-in (scripts/technitium-sso.py) ─────────────────────
# Technitium speaks OIDC itself (Settings → Single Sign-On). The oauth2-proxy
# gateway at dns.<domain> proves *someone* signed in and never *who*, so without
# this the console keeps a password of its own and the DNS/DHCP admin plane has a
# credential outside Authentik. The client below is created by
# `python3 scripts/authentik-setup.py technitium` (setup.sh --with-authentik does
# both). The authority is derived from SSO_AUTHENTIK_BASE and the app slug.
TECHNITIUM_SSO_ENABLED=true
# `groups` is what makes the map below work: Authentik only emits the claim when
# the scope is asked for, and a mapped user without it signs in as a plain user.
TECHNITIUM_SSO_SCOPES=openid,profile,email,groups
TECHNITIUM_SSO_GROUP_MAP=cerulean-platform:Administrators
TECHNITIUM_SSO_ALLOW_SIGNUP=false
TECHNITIUM_SSO_SIGNUP_ONLY_FOR_MAPPED_USERS=true
# Primary zone (defaults to <serverId>.lab.innotel.us when empty). Also used to derive fallback zone.
CERULEAN_ZONE=
# Seconds to wait after publishing a TXT before Let's Encrypt verifies
PROPAGATION_BUFFER_SECONDS=10
# ── Bundled Technitium container (only when using --profile technitium) ──────
# Runs with network_mode: host — binds :53 (DNS), :67 (DHCP) and :5380 (console)
# directly on the host. scripts/setup.sh automatically disables systemd-resolved's
# stub listener so :53 is free; set CERULEAN_KEEP_RESOLVED=1 to opt out.
TECHNITIUM_ADMIN_PASSWORD=
TECHNITIUM_DOMAIN=
# With host networking these ports are the host ports Technitium binds (documentation
# only — docker port mappings are not used):
TECHNITIUM_DNS_UDP_PORT=53
TECHNITIUM_DNS_TCP_PORT=53
TECHNITIUM_WEB_PORT=5380
TECHNITIUM_DHCP_PORT=67
# Set CERULEAN_KEEP_RESOLVED=1 to leave systemd-resolved alone (remote-only DNS).
CERULEAN_KEEP_RESOLVED=0
DNS_SERVER_PREFER_IPV6=false
DNS_SERVER_RECURSION=AllowOnlyForPrivateNetworks
DNS_SERVER_ENABLE_BLOCKING=true
DNS_SERVER_BLOCK_LIST_URLS=
DNS_SERVER_FORWARDERS=1.1.1.1,8.8.8.8
DNS_SERVER_FORWARDER_PROTOCOL=Udp

# ─── Authentik (SSO / user management) ─────────────────────────────────────────
AUTHENTIK_ISSUER_URL=
AUTHENTIK_CLIENT_ID=cerulean
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://cerulean.innotel.us/api/auth/oidc/callback
# The IdP origin every gateway and relying party is pointed at (no trailing
# slash). SSO_APP_SLUG is the application the zone's gateways sign in as; both
# are read by scripts/technitium-sso.py when it derives the console's authority.
SSO_AUTHENTIK_BASE=
SSO_APP_SLUG=innotel-app-gateway
# The Technitium console's own OIDC client. Created by
# `python3 scripts/authentik-setup.py technitium`; its callback is the console's
# /sso/callback path on the name the gateway serves it on.
AUTHENTIK_TECHNITIUM_APP_NAME=Technitium DNS
AUTHENTIK_TECHNITIUM_CLIENT_ID=technitium
AUTHENTIK_TECHNITIUM_CLIENT_SECRET=
AUTHENTIK_TECHNITIUM_REDIRECT_URI=https://dns.internal.innotel.us/sso/callback
AUTHENTIK_ADMIN_USER=akadmin
AUTHENTIK_ADMIN_PASSWORD=
AUTHENTIK_BOOTSTRAP_PASSWORD=
# Bootstrap API token — REQUIRED by scripts/authentik-setup.py and
# scripts/verify-forward-auth.py (Bearer auth; Authentik 2024.12 removed the
# admin-login endpoint). Authentik prints its bootstrap credentials once in the
# server log on first boot, otherwise mint one under Directory → Tokens.
AUTHENTIK_BOOTSTRAP_TOKEN=
# Email the bootstrap admin is created with (docker-compose default:
# admin@cerulean.innotel.us).
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_POSTGRESQL_PASSWORD=

# ─── Secret vault (HashiCorp Vault — the stack's secret store) ───────────────
# The stack ships a durable, file-backed Vault (KV v2):
#     docker compose --profile vault up -d
# On start it initialises itself, unseals, and writes a non-expiring token
# scoped to VAULT_PREFIX to ./data/vault/token/cerulean.token. The app reads that
# file instead of holding a token (VAULT_TOKEN_FILE is the path inside the app
# container). The unseal key and root token stay in ./data/vault/init/init.json,
# which only the vault container mounts — back it up.
# Point VAULT_ADDR at an external Vault and set VAULT_TOKEN to override; leave
# VAULT_ADDR empty to disable the integration entirely.
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_TOKEN_FILE=/vault/token/cerulean.token
VAULT_PREFIX=cerulean
# Products that get their own token, narrowed to <prefix>/data/<product>, for
# anything that must not hold the mount-wide grant. Space-separated. The
# entrypoint writes each policy and mints /vault/token/<product>.token.
VAULT_PRODUCT_TOKENS=

# ─── Certificate discovery ─────────────────────────────────────────────────────
CERT_DISCOVERY_DIRS=

# ─── DNS health auditing ───────────────────────────────────────────────────────
DNS_AUDIT_ENABLED=1
DNS_AUDIT_RESOLVERS=8.8.8.8,1.1.1.1,9.9.9.9

# ─── Let's Encrypt / ACME ──────────────────────────────────────────────────────
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
ACME_EMAIL=admin@innotel.us

# ─── nginx proxy manager ───────────────────────────────────────────────────────
# local: the edge runs beside Cerulean (the bundled NPM in
# compose.cerulean.yml, reached in-network as cerulean-npm). remote: talk to an
# external NPM through NPM_API_URL. The Innotel edge is local — the separate
# 192.168.1.71 edge box was retired.
NPM_MODE=local
NPM_API_URL=http://192.168.1.46:81
NPM_INTERNAL_API_URL=http://cerulean-npm:81
NPM_LOCAL_API_URL=http://127.0.0.1:81
NPM_ADMIN_PORT=81
# Address a BROWSER can reach for the NPM admin UI. Leave this empty and
# scripts/setup.sh fills it in with this host's LAN IP (NPM_HOST_IP when set)
# at install time; server/src/config.ts then uses NPM_HOST_IP as the same
# intermediate fallback. Without either, NPM_MODE=local falls back to
# http://127.0.0.1:<NPM_ADMIN_PORT> — an address only valid ON the NPM host,
# so the dashboard's NPM link fails from every other machine.
NPM_PUBLIC_API_URL=
# The real public port is 80: the cutover completed (zeus-freepbx repointed to
# :8083 only, host :80 belongs to the edge, router forwards :80/:443 here).
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
# Bootstrap admin for the bundled NPM (NPM_MODE=local). NPM only creates it
# while the user table is empty; NPM_EMAIL/NPM_PASSWORD are the credentials the
# platform then uses, and must be the same account.
NPM_ADMIN_EMAIL=admin@innotel.us
NPM_ADMIN_PASSWORD=
NPM_BACKUP_UI_PORT=82
NPM_DB_MYSQL_PASSWORD=
NPM_DB_ROOT_PASSWORD=
NPM_BACKUP_UI_USER=
NPM_BACKUP_UI_PASSWORD=
NPM_CRON_SCHEDULE='0 2 * * *'
NPM_BACKUP_RETENTION=7
NPM_EMAIL=admin@innotel.us
NPM_PASSWORD=change-me
NPM_FORWARD_HOST=192.168.1.46
NPM_HOST_IP=
# ── NPM admin UI: Authentik forward-auth sign-in ─────────────────────────────
# Identity for the edge's own admin UI belongs to Authentik like everything
# else. With these set, proxy.innotel.us / admin.zeus / admin.monarch sign in
# through the zone gate and the password form is closed; NPM_EMAIL above stays
# as the machine account Cerulean's automation provisions hosts with (it is
# allowed to use the password grant off-edge, and nobody else is).
#
# The admin hosts must forward to the UI's LOOPBACK address (127.0.0.1) rather
# than this host's LAN IP: nginx runs inside the NPM container, so the edge's
# requests are the only ones that arrive on loopback, and the app believes
# X-authentik-* only there. A host pointing at the LAN IP gets no SSO.
NPM_SSO_ENABLED=0
NPM_SSO_REQUIRED_GROUP=cerulean-platform
# ── Shared oauth2-proxy session store (cerulean-sso-sessions) ───────────────
# One store for every SSO gateway on the platform, so a single Authentik
# sign-in covers the edge, the media apps and the app gateways. Published on the
# host's loopback and the docker0 gateway only — every container reaches
# 172.17.0.1, nothing on the LAN reaches it.
# Generate the password with:  openssl rand -hex 32
SSO_SESSION_REDIS_PASSWORD=
SSO_SESSION_REDIS_BIND=127.0.0.1
SSO_SESSION_REDIS_DOCKER_BIND=172.17.0.1
SSO_SESSION_REDIS_HOST=172.17.0.1
SSO_SESSION_REDIS_PORT=16380
NPM_SSO_ADMIN_GROUP=cerulean-platform
NPM_SSO_AUTO_CREATE=1
NPM_SSO_SERVICE_ACCOUNTS=admin@innotel.us
# Recovery only: re-enables the password form on the admin UI. Unset and
# restart cerulean-npm once Authentik answers again.
NPM_BREAKGLASS_LOGIN=
NPM_BASE_DOMAIN=
NPM_PROXY_SSL=0
NPM_WILDCARD_ATTACH=1

# ─── Internal PKI (TLS client certificates for devices) ───────────────────────
CA_COMMON_NAME='Cerulean Root CA'
CA_VALIDITY_DAYS=3650
PKI_CERT_VALIDITY_DAYS=825
PKI_SCEP_URL=
PKI_SCEP_CA_NAME=cerulean
PKI_SCEP_CHALLENGE=

# ─── Multi-tenancy (organizations) ──────────────────────────────────────────
TENANT_PLATFORM_GROUP=cerulean-platform
# AUTHENTIK_API_URL is a full origin, e.g. https://auth.cerulean.innotel.us.
# The admin user/password it authenticates with are the ones in the Authentik
# block above (AUTHENTIK_ADMIN_USER / AUTHENTIK_ADMIN_PASSWORD) — do not repeat
# them here, a second definition silently wins on the last line of the file.
AUTHENTIK_API_URL=


# ─── Zeus PBX (now SSO via this repo's Authentik) ─────────────────────────
# Source was a 'standalone authentik' env on zeus-pbx-platform; moved to
# this repo's bundled Authentik (ghcr.io/goauthentik). Provider 23/client zeus.
ZEUS_AUTHENTIK_ISSUER=https://auth.zeus.innotel.us/application/o/zeus
ZEUS_AUTHENTIK_CLIENT_ID=zeus
ZEUS_AUTHENTIK_PROVIDER_ID=23

# ─── Vault UI sign-in (Cerulean Authentik OIDC, bootstrap step 4c) ───────────
# The Vault UI signs in through Authentik instead of a pasted token. Leave the
# secret empty to skip the step entirely (the UI then keeps its token login).
# The discovery URL is the APPLICATION-scoped path with its trailing slash: Vault
# requires the discovery document own issuer to equal this URL, and Authentik
# advertises the app-scoped issuer for this provider.
VAULT_OIDC_CLIENT_ID=vault
VAULT_OIDC_CLIENT_SECRET=
VAULT_OIDC_DISCOVERY_URL=https://auth.cerulean.innotel.us/application/o/vault/
VAULT_OIDC_GROUP=cerulean-platform
VAULT_OIDC_REDIRECT=https://secrets.cerulean.innotel.us/ui/vault/auth/oidc/oidc/callback
