# ─── Cerulean portal ───────────────────────────────────────────────────────────
# Port the portal (API + dashboard) listens on
CERULEAN_PORT=3000
# Password for the portal's admin login (required — bootstrap fallback)
CERULEAN_ADMIN_PASSWORD=change-me
# Token expiry for portal logins, in hours
CERULEAN_TOKEN_TTL_HOURS=12
# 0 disables the admin-password login entirely (Authentik-only sign-in).
# The password is still required in .env because the server refuses to start
# without it — keep it, even when AUTH_LOCAL_ENABLED=0.
AUTH_LOCAL_ENABLED=1

# ─── Authentik (SSO / user management) ─────────────────────────────────────────
# OIDC issuer of your Authentik instance, e.g. http://auth.cerulean.innotel.us
# or http://<host>:9000 while the stack is being set up. When set, the login
# page offers "Sign in with Authentik". The stack includes Authentik itself
# (docker compose --profile authentik up -d); ./scripts/authentik-setup.py
# provisions the OIDC provider + application automatically.
AUTHENTIK_ISSUER_URL=
AUTHENTIK_CLIENT_ID=cerulean
AUTHENTIK_CLIENT_SECRET=
# Callback URL registered with Authentik — must match exactly
AUTHENTIK_REDIRECT_URI=http://cerulean.innotel.us/api/auth/oidc/callback
# Optional: admin credentials for ./scripts/authentik-setup.py (it logs in to
# create/update the OIDC provider). Bootstrap password for the very first run:
AUTHENTIK_ADMIN_USER=akadmin
AUTHENTIK_ADMIN_PASSWORD=
AUTHENTIK_BOOTSTRAP_PASSWORD=
# Compose-only (--profile authentik):
AUTHENTIK_SECRET_KEY=
AUTHENTIK_POSTGRESQL_PASSWORD=

# ─── Secret vault (HashiCorp Vault) ────────────────────────────────────────────
# When set, private keys + acme-dns credentials are mirrored into Vault (KV v2)
# and .env values may reference vault://<path>#<key> instead of plaintext.
# The compose stack ships a dev-mode Vault (docker compose --profile vault up -d).
VAULT_ADDR=
VAULT_TOKEN=
VAULT_PREFIX=cerulean

# ─── Certificate discovery ─────────────────────────────────────────────────────
# Extra directories scanned for PEM certificates (in addition to nginx proxy
# manager), comma-separated. e.g. /etc/ssl/certs,/opt/certs
CERT_DISCOVERY_DIRS=

# ─── DNS health auditing ───────────────────────────────────────────────────────
# Public resolvers used to check propagation consistency. 0 disables audits.
DNS_AUDIT_ENABLED=1
DNS_AUDIT_RESOLVERS=8.8.8.8,1.1.1.1,9.9.9.9

# ─── Let's Encrypt / ACME ──────────────────────────────────────────────────────
# Use the staging directory while testing to avoid rate limits:
#   https://acme-staging-v02.api.letsencrypt.org/directory
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# Contact email for Let's Encrypt account + expiry notices
ACME_EMAIL=admin@innotel.us

# ─── DNS-01 strategy ───────────────────────────────────────────────────────────
# Which challenge strategy to use: 'bind' (default — nsupdate TXT records
# straight into your authoritative BIND server) or 'acmedns' (delegated
# challenges via the acme-dns server in the 'acmedns' compose profile).
CERULEAN_STRATEGY=bind

# ─── BIND server (SSH + nsupdate/TSIG) ─────────────────────────────────────────
BIND_SSH_HOST=192.168.1.80
BIND_SSH_PORT=22
BIND_SSH_USER=root
# Prefer key auth: BIND_SSH_KEY_PATH. Password is only used when no key is set.
BIND_SSH_KEY_PATH=
BIND_SSH_PASSWORD=
# TSIG key used to sign dynamic updates. ./scripts/setup-bind.sh generates and
# installs it automatically. Must match named.conf exactly.
BIND_TSIG_NAME=cerulean
BIND_TSIG_SECRET=
# Zones Cerulean manages (comma-separated). Defaults to CERULEAN_ZONE.
BIND_ZONES=innotel.us
# Primary zone managed by this portal (innotel.us)
CERULEAN_ZONE=innotel.us
# Seconds to wait after an nsupdate before Let's Encrypt verifies
PROPAGATION_BUFFER_SECONDS=10

# ─── acme-dns (optional — only for the 'acmedns' strategy) ─────────────────────
# API base URL of the acme-dns server (from the portal container: http://acme-dns:4443)
ACMEDNS_API_URL=http://acme-dns:4443
# Public IP of the host running acme-dns on port 53 (needed for the delegation
# records it serves). Leave blank if you use the 'bind' strategy.
ACMEDNS_PUBLIC_IP=
# Domain the acme-dns server is authoritative for, e.g. auth.innotel.us
ACMEDNS_DOMAIN=auth.innotel.us
# Optional: restrict acme-dns /update calls to the portal's egress IP (CIDR list)
ACMEDNS_ALLOW_FROM=

# ─── nginx proxy manager ───────────────────────────────────────────────────────
NPM_API_URL=http://192.168.1.71:81
NPM_EMAIL=admin@innotel.us
NPM_PASSWORD=change-me
# Upstream IP that NPM proxy hosts forward to (the portal host's LAN IP — must
# be reachable from the NPM host). Leave blank to auto-detect the setup host's
# LAN IP. Used by ./scripts/npm-proxy-hosts.py.
NPM_FORWARD_HOST=
# LAN IP of the nginx proxy manager host itself. When set (together with
# BIND_SSH_* + BIND_TSIG_SECRET), ./scripts/npm-proxy-hosts.py also creates an
# A record for every subdomain pointing at NPM, so app./api./auth./dns./certs./
# admin.<base> actually resolve.
NPM_HOST_IP=
# Base domain the provisioned proxy hosts live under; each service gets its own
# subdomain (e.g. cerulean.<base>). Defaults to CERULEAN_ZONE.
NPM_BASE_DOMAIN=
# 1 = let NPM request its own Let's Encrypt certificates for each proxy host
# (HTTP-01 — requires ports 80/443 to reach NPM). Leave 0 to create hosts
# without SSL and attach a Cerulean-issued certificate from the portal.
NPM_PROXY_SSL=0
# 1 (default) = after issuance/renewal, a wildcard certificate (e.g.
# *.innotel.us) is also attached to every matching subdomain proxy host (e.g.
# cerulean.innotel.us) — unless the host already has its own certificate.
# 0 = only attach certificates that match a proxy host domain exactly.
NPM_WILDCARD_ATTACH=1
